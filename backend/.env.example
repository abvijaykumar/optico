# Copy to .env and edit.
ENVIRONMENT=dev
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# LLM provider — configure at least one. Leave both blank to use the fake LLM
# (deterministic mock responses — useful for demos and tests).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_MODEL=claude-opus-4-7

# Neo4j — optional. If unreachable the KG falls back to in-memory mode.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=optico-dev-password

# Redis
REDIS_URL=redis://redis:6379/0

# Postgres (if using durable storage)
DATABASE_URL=sqlite+aiosqlite:///./optico.db

# Autonomy defaults
DEFAULT_AUTONOMY_LEVEL=0
AUTONOMY_PROMOTION_MIN_RUNS=30
AUTONOMY_PROMOTION_MIN_ACCURACY=0.95
AUTONOMY_PROMOTION_MAX_CALIBRATION_ERROR=0.10
